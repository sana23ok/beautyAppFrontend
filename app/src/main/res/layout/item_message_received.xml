<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_message_received"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <FrameLayout
            android:id="@+id/media_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:id="@+id/iv_media"
                android:layout_width="204dp"
                android:layout_height="wrap_content"
                android:minHeight="112dp"
                android:adjustViewBounds="true"
                android:maxHeight="240dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_chat_media_placeholder"
                android:contentDescription="@string/chat_attachment_preview" />

            <ImageView
                android:id="@+id/iv_play"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:visibility="gone"
                android:src="@drawable/ic_chat_play"
                tools:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/tv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="Sure! What time works best for you?" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:textColor="@color/guava_sage"
            android:textSize="11sp"
            tools:text="10:32" />

    </LinearLayout>

</FrameLayout>
